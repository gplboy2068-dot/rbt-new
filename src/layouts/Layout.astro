---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RBT Practice Exam — 100% Free RBT Exam Preparation Platform',
  description = 'Master the BACB Registered Behavior Technician (RBT) Exam with free practice questions, timed mock exams, SuperMemo-2 flashcards, and an AI tutor on rbtpracticeexam.xyz. Zero login required.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#059669" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="kYGvLffX4BM4uUM7RBbc8mWgAfdFGxISBKyopIyZUdM" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('rtb_theme')) {
          return localStorage.getItem('rtb_theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-brand-500 selection:text-white transition-colors duration-200">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-2">
          {/* Brand Logo */}
          <a href="/" class="flex items-center space-x-2.5 min-w-0 group">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white font-black shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-1.5 truncate">
                <span>RBT Practice Exam</span>
                <span class="hidden sm:inline-block text-brand-600 dark:text-brand-400 text-[9px] font-extrabold px-1.5 py-0.5 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 shrink-0">100% FREE</span>
              </span>
              <p class="hidden sm:block text-[10px] text-slate-500 dark:text-slate-400 -mt-0.5 font-semibold truncate">
                rbtpracticeexam.xyz • BACB Task List 2nd & 6th Edition
              </p>
            </div>
          </a>

          {/* Desktop Navigation Links */}
          <nav class="hidden lg:flex items-center space-x-1 text-xs sm:text-sm font-bold">
            <a href="/study" class="px-3 py-2 rounded-xl text-brand-600 dark:text-brand-400 bg-brand-50/70 dark:bg-brand-950/50 hover:bg-brand-100 dark:hover:bg-brand-900/60 transition-colors flex items-center gap-1.5 font-extrabold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414" /></svg>
              <span>Unlimited Study</span>
            </a>
            <a href="/practice-questions" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
              Questions
            </a>
            <a href="/practice-tests" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
              Topic Tests
            </a>
            <a href="/mock-exams" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
              Mock Exams
            </a>
            <a href="/flashcards" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
              Flashcards
            </a>
            <a href="/ai-tutor" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors flex items-center gap-1.5">
              <span>AI Tutor</span>
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </a>
            <a href="/study-guides" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
              Guides
            </a>
            <a href="/topics" class="px-3 py-2 rounded-xl text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
              Topics
            </a>
          </nav>

          {/* Right Action: Local Storage Status & Theme Toggle & Mobile Hamburger */}
          <div class="flex items-center space-x-1.5 sm:space-x-2.5 shrink-0">
            <a
              href="/analytics"
              class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 text-xs font-bold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-xl hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <span>My Analytics</span>
            </a>

            <button
              id="theme-toggle-btn"
              aria-label="Toggle Dark Theme"
              class="p-2.5 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            >
              <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </button>

            <!-- Prominent Mobile Hamburger Menu Button -->
            <button
              id="mobile-menu-btn"
              type="button"
              aria-label="Open Navigation Menu"
              class="lg:hidden p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-95 transition-all flex items-center justify-center shadow-sm"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Modern Full-Height Mobile Drawer (Slides from Right) -->
      <div
        id="mobile-drawer"
        class="hidden fixed inset-0 z-[99999]"
        role="dialog"
        aria-modal="true"
      >
        <!-- Backdrop -->
        <div
          id="mobile-drawer-backdrop"
          class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm transition-opacity duration-300 opacity-0"
        ></div>

        <!-- Sliding Panel -->
        <div
          id="mobile-drawer-panel"
          class="fixed inset-y-0 right-0 w-[85vw] max-w-sm h-[100dvh] bg-white dark:bg-slate-900 p-5 sm:p-6 shadow-2xl flex flex-col justify-between space-y-6 overflow-y-auto transform translate-x-full transition-transform duration-300 ease-out z-[100000] border-l border-slate-200 dark:border-slate-800"
        >
          <div class="space-y-5">
            <!-- Drawer Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center space-x-2.5">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white font-black text-xs shadow-md">
                  RBT
                </div>
                <div>
                  <span class="text-sm font-black text-slate-900 dark:text-white block">RBT Practice Exam</span>
                  <span class="block text-[10px] text-emerald-600 dark:text-emerald-400 font-bold uppercase tracking-wider">rbtpracticeexam.xyz • 100% Free</span>
                </div>
              </div>
              <button
                id="close-drawer-btn"
                type="button"
                aria-label="Close Navigation Menu"
                class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Navigation Links -->
            <nav class="flex flex-col space-y-1.5 text-sm font-bold">
              <a
                href="/study"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl bg-brand-50/80 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 font-extrabold border border-brand-200 dark:border-brand-800 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414" /></svg>
                  <span>Unlimited Study</span>
                </div>
                <span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-brand-600 text-white">OPEN</span>
              </a>

              <a
                href="/practice-questions"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                  <span>Practice Questions</span>
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500">60Q+</span>
              </a>

              <a
                href="/practice-tests"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                  <span>Topic Tests</span>
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600">Drills</span>
              </a>

              <a
                href="/mock-exams"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span>Mock Exams</span>
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/60 text-amber-600">85Q Timed</span>
              </a>

              <a
                href="/flashcards"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                  <span>SRS Flashcards</span>
                </div>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-50 dark:bg-purple-950/60 text-purple-600">SM-2</span>
              </a>

              <a
                href="/ai-tutor"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">AI Clinical Tutor</span>
                </div>
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              </a>

              <a
                href="/study-guides"
                class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <span>Study Guides</span>
              </a>

              <a
                href="/topics"
                class="mobile-nav-link flex items-center gap-3 p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                <span>BACB Topics</span>
              </a>

              <a
                href="/analytics"
                class="mobile-nav-link flex items-center justify-between p-3 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                  <span>My Analytics</span>
                </div>
              </a>
            </nav>
          </div>

          <!-- Drawer Footer -->
          <div class="pt-4 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-500 space-y-3">
            <div class="flex items-center justify-between font-bold">
              <span>Open Access Model</span>
              <span class="text-emerald-600 dark:text-emerald-400">100% Free</span>
            </div>
            <div class="flex flex-wrap gap-2 text-[11px] text-slate-400 dark:text-slate-500">
              <a href="/privacy" class="hover:underline">Privacy</a> •
              <a href="/terms" class="hover:underline">Terms</a> •
              <a href="/disclaimer" class="hover:underline">Disclaimer</a> •
              <a href="/about" class="hover:underline">About</a> •
              <a href="/contact" class="hover:underline">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-20 transition-colors text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-100 dark:border-slate-800">
          <!-- Col 1 -->
          <div class="space-y-3">
            <div class="flex items-center space-x-2">
              <span class="text-base font-black text-slate-900 dark:text-white">RBT Practice Exam</span>
              <span class="text-[10px] text-brand-600 dark:text-brand-400 font-bold px-2 py-0.5 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800">OPEN ACCESS</span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
              100% free, open-access RBT examination preparation on <strong>rbtpracticeexam.xyz</strong>. Master the BACB Task List with AI-guided tutoring, practice tests, and spaced repetition flashcards.
            </p>
          </div>

          <!-- Col 2 -->
          <div class="space-y-2.5">
            <div class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">Learning Modules</div>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 font-medium">
              <li><a href="/practice-questions" class="hover:text-brand-600">Practice Questions</a></li>
              <li><a href="/practice-tests" class="hover:text-brand-600">Topic Practice Tests</a></li>
              <li><a href="/mock-exams" class="hover:text-brand-600">85Q Timed Mock Exams</a></li>
              <li><a href="/flashcards" class="hover:text-brand-600">SuperMemo-2 Flashcards</a></li>
              <li><a href="/ai-tutor" class="hover:text-brand-600">AI Clinical Tutor</a></li>
            </ul>
          </div>

          <!-- Col 3 -->
          <div class="space-y-2.5">
            <div class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">BACB Task List Areas</div>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 font-medium">
              <li><a href="/topics/continuous-measurement" class="hover:text-brand-600">Domain A: Measurement</a></li>
