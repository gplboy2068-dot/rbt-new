---
import Layout from '@/layouts/Layout.astro';
---

<Layout 
  title="Contact & Question Error Reporting — RBT Practice AI"
  description="Report a question typo, request new task list content, or send feedback to the editorial team on rbtpracticeai.com."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
        Feedback & Support
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">
        Contact & Question Reports
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl">
        Found an issue with a question or have a suggestion? We review all feedback to ensure clinical accuracy.
      </p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-6">
      <form class="space-y-4 text-sm" onsubmit="event.preventDefault(); alert('Thank you! Your feedback has been received.');">
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Subject
          </label>
          <select class="w-full p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200">
            <option>Report Question Typo or Discrepancy</option>
            <option>Suggest a New Topic / Feature</option>
            <option>General Feedback</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Question ID / Code (if applicable)
          </label>
          <input 
            type="text" 
            placeholder="e.g. RBT-A-001" 
            class="w-full p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm" 
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Details & Clinical Rationale
          </label>
          <textarea 
            rows="5" 
            required 
            placeholder="Describe the issue or feedback in detail..." 
            class="w-full p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md transition-all"
        >
          Submit Feedback
        </button>
      </form>
    </div>
  </div>
</Layout>
