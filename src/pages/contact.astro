---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Contact Us | RBTPracticeExam.xyz"
  description="Contact RBTPracticeExam.xyz with questions, feedback, corrections, or other inquiries about our RBT exam preparation resources."
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-8 animate-fadeIn text-slate-800 dark:text-slate-200">
    
    {/* Page Header */}
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-300 text-xs font-bold uppercase tracking-wider">
        <span>Get in Touch</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Contact Us
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Have a question, found an error, or have a suggestion? We'd love to hear from you.
      </p>
    </header>

    {/* Independent Notice */}
    <section class="p-4 sm:p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-200 text-xs sm:text-sm leading-relaxed">
      <strong>Please note:</strong> RBTPracticeExam.xyz is an independent educational study website. We are <strong>not the official website of the BACB</strong> and cannot answer official examination registration, scheduling, or application status inquiries.
    </section>

    {/* Contact Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      {/* 1. Direct Email Card */}
      <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center text-brand-600 dark:text-brand-400 text-xl font-bold">
            ✉️
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">
            Email Us Directly
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            You can reach our team directly by email for any general questions, feedback, or inquiries about the website.
          </p>
        </div>
        <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
          <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Contact Email</div>
          <a
            href="mailto:support@rbtpracticeexam.xyz"
            class="inline-block text-base sm:text-lg font-bold text-brand-600 dark:text-brand-400 hover:underline break-all"
          >
            support@rbtpracticeexam.xyz
          </a>
        </div>
      </section>

      {/* 2. Message Topics / What We Can Help With */}
      <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl font-bold">
          💬
        </div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
          What You Can Contact Us About
        </h2>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>General questions about using our study tools</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Reporting a question typo, mistake, or discrepancy</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Reporting a technical problem or broken link</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Suggestions for new study features or topics</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Privacy or Terms & Conditions inquiries</span>
          </li>
        </ul>
      </section>

    </div>

    {/* Question / Error Reporting Guidance */}
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-purple-600 dark:text-purple-400 text-lg font-bold">
          🔍
        </div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
          Found an Error in a Practice Question?
        </h2>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        We strive for high educational accuracy across all our practice items. If you believe a practice question, answer option, or explanation contains an error, please email us with the following helpful details:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm pt-1">
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-1">
          <div class="font-bold text-slate-900 dark:text-white">1. Question Details</div>
          <div class="text-slate-500 dark:text-slate-400 text-xs">Question ID, topic name, or a brief snippet of the question text.</div>
        </div>
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-1">
          <div class="font-bold text-slate-900 dark:text-white">2. What Appears Incorrect</div>
          <div class="text-slate-500 dark:text-slate-400 text-xs">Describe the typo, answer key issue, or incorrect explanation.</div>
        </div>
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-1">
          <div class="font-bold text-slate-900 dark:text-white">3. Explanation / Source</div>
          <div class="text-slate-500 dark:text-slate-400 text-xs">Why you believe it needs review and any textbook or task list reference.</div>
        </div>
      </div>
      <div class="pt-2">
        <a
          href="mailto:support@rbtpracticeexam.xyz?subject=Question%20Error%20Report"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm shadow transition-colors"
        >
          <span>Report a Question via Email</span>
          <span>→</span>
        </a>
      </div>
    </section>

    {/* Privacy & Security Reminder */}
    <section class="p-5 rounded-2xl bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
      <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🔒 Privacy & Security Reminder</span>
      </div>
      <p>
        Please <strong>do not include passwords, payment information, government identification, or other sensitive personal information</strong> in your message. We only require the basic information needed to address your question or feedback.
      </p>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        *We review incoming messages and respond when appropriate.*
      </p>
    </section>

    {/* Related Legal & Information Pages */}
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-3">
      <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
        Related Information & Policies
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Before reaching out, you may also find answers in our legal and informational resources:
      </p>
      <div class="flex flex-wrap gap-4 pt-1 text-xs sm:text-sm font-semibold">
        <a href="/privacy-policy" class="text-brand-600 dark:text-brand-400 underline hover:text-brand-700">
          Privacy Policy
        </a>
        <span>•</span>
        <a href="/terms-and-conditions" class="text-brand-600 dark:text-brand-400 underline hover:text-brand-700">
          Terms & Conditions
        </a>
        <span>•</span>
        <a href="/disclaimer" class="text-brand-600 dark:text-brand-400 underline hover:text-brand-700">
          Disclaimer
        </a>
        <span>•</span>
        <a href="/about" class="text-brand-600 dark:text-brand-400 underline hover:text-brand-700">
          About Us
        </a>
      </div>
    </section>

  </main>
</Layout>
