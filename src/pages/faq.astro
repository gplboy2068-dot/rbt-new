---
import Layout from '@/layouts/Layout.astro';

const FAQS = [
  {
    category: 'BACB Exam & Certification',
    q: 'How many questions are on the real RBT Exam?',
    a: 'The BACB RBT certification exam consists of 85 multiple-choice questions (75 scored items and 10 unscored pilot items). You are allotted 90 minutes to complete the test.',
  },
  {
    category: 'BACB Exam & Certification',
    q: 'What is the passing score for the RBT Exam?',
    a: 'The BACB uses a criterion-referenced passing score determined by subject matter experts. The raw passing score scales to a scaled score of 200 (approximately ~80% accuracy).',
  },
  {
    category: 'Platform & Access',
    q: 'Is this platform really 100% free with zero signup?',
    a: 'Yes. In accordance with our Open Access model, all practice questions, timed mock exams, SuperMemo-2 flashcards, and AI study tools are 100% free with zero registration or paywalls.',
  },
  {
    category: 'Data & Privacy',
    q: 'Where is my study progress saved if I do not create an account?',
    a: 'Your progress is stored locally in your browser using IndexedDB. You can export a 1-Click JSON backup anytime from the Analytics page to transfer your data across devices.',
  },
  {
    category: 'AI Study Tutor',
    q: 'How does the AI Study Tutor work?',
    a: 'The AI Tutor runs on high-performance LLM engines (DeepSeek, OpenAI, Anthropic) trained with BACB Task List 2nd Edition clinical scenarios. Anonymous IP rate limits prevent abuse while providing generous free daily study quotas.',
  },
];
---

<Layout 
  title="Frequently Asked Questions (FAQ) — RBT Exam Prep"
  description="Common questions regarding the BACB RBT exam format, passing threshold, anonymous local storage, and AI tutor usage."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
        Help & Guidance
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">
        Frequently Asked Questions
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl">
        Everything you need to know about the BACB Registered Behavior Technician exam and our open-access prep platform.
      </p>
    </div>

    <div class="space-y-4">
      {FAQS.map((item, idx) => (
        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-7 shadow-sm space-y-2">
          <div className="text-[11px] font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
            {item.category}
          </div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">
            {item.q}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
            {item.a}
          </p>
        </div>
      ))}
    </div>
  </div>
</Layout>
