---
import Layout from '@/layouts/Layout.astro';
import ReviewDate from '@/components/ReviewDate.astro';
import { FAQ_CATEGORIES, FAQ_ENTRIES, OFFICIAL_RESOURCES } from '@/data/faq-data';

// Group entries by category
const faqsByCategory = FAQ_CATEGORIES.map(category => ({
  ...category,
  items: FAQ_ENTRIES.filter(item => item.categoryId === category.id)
}));

// Build JSON-LD structured data
const faqPageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "@id": "https://rbtpracticeexam.xyz/faq#faqpage",
      "url": "https://rbtpracticeexam.xyz/faq",
      "name": "Frequently Asked Questions (FAQ) — RBT Exam Prep & Pearson VUE Rules",
      "description": "Comprehensive, verified answers to common questions about the BACB RBT exam format, Pearson VUE testing rules, ID requirements, study strategies, and retesting policies.",
      "mainEntity": FAQ_ENTRIES.map(entry => ({
        "@type": "Question",
        "name": entry.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": entry.answerText
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://rbtpracticeexam.xyz/faq#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://rbtpracticeexam.xyz"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "FAQ",
          "item": "https://rbtpracticeexam.xyz/faq"
        }
      ]
    }
  ]
};
---

<Layout 
  title="Frequently Asked Questions (FAQ) — RBT Exam Prep & Testing Rules"
  description="Comprehensive, verified answers to common questions about the BACB RBT exam format, Pearson VUE testing rules, ID requirements, study strategies, and retesting policies."
  canonical="https://rbtpracticeexam.xyz/faq"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 text-slate-800 dark:text-slate-200">
    
    <!-- Hero Header -->
    <header class="border-b border-slate-200 dark:border-slate-800 pb-8 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-300 text-xs font-bold uppercase tracking-wider">
          <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Candidate Help & Exam Guidance</span>
        </div>

        <ReviewDate 
          publishedAt="2026-01-15T00:00:00Z"
          updatedAt="2026-09-24T00:00:00Z"
          lastReviewed="2026-09-24T00:00:00Z"
        />
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Frequently Asked Questions
      </h1>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Everything you need to know about the Registered Behavior Technician® (RBT®) examination, Pearson VUE testing-center rules, preparation frameworks, practice test scoring, and our open-access study platform.
      </p>

      <!-- Search Input Filter -->
      <div class="pt-2">
        <label for="faq-search" class="sr-only">Search frequently asked questions</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="search" 
            id="faq-search"
            placeholder="Search questions (e.g. calculator, IDs, 30 days, retest, breaks)..." 
            class="w-full pl-10 pr-4 py-2.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all shadow-sm"
          />
        </div>
      </div>
    </header>

    <!-- Independent Notice & Disclaimer -->
    <section class="p-4 sm:p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-200 text-xs sm:text-sm leading-relaxed space-y-1.5" aria-label="Disclaimer">
      <div class="font-bold flex items-center gap-2 text-amber-800 dark:text-amber-300 uppercase tracking-wide text-xs">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Independent Educational Resource Notice</span>
      </div>
      <p>
        <strong>RBTPracticeExam.xyz is an independent study and preparatory website.</strong> We are not affiliated with, authorized by, sponsored by, or endorsed by the Behavior Analyst Certification Board® (BACB®) or Pearson VUE. RBT® and BACB® are registered trademarks. All questions, simulated tests, and study guides on this platform are independent educational items and are <strong>not official or actual BACB examination questions</strong>.
      </p>
    </section>

    <!-- Quick Navigation Category Anchor Pills -->
    <nav class="space-y-2" aria-label="FAQ Categories">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Jump to Category
      </div>
      <div class="flex flex-wrap gap-2">
        {FAQ_CATEGORIES.map(cat => (
          <a
            href={`#${cat.id}`}
            class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-brand-50 hover:text-brand-700 dark:hover:bg-brand-950/60 dark:hover:text-brand-300 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors"
          >
            {cat.title}
          </a>
        ))}
      </div>
    </nav>

    <!-- FAQ Accordion Sections by Category -->
    <div class="space-y-10" id="faq-container">
      {faqsByCategory.map(cat => (
        <section id={cat.id} class="faq-category space-y-4 scroll-mt-20">
          <div class="border-b border-slate-200 dark:border-slate-800 pb-3 space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800">
                {cat.badge}
              </span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
              {cat.title}
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
              {cat.description}
            </p>
          </div>

          <div class="space-y-3">
            {cat.items.map(item => (
              <details class="faq-item group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-6 shadow-sm hover:border-slate-300 dark:hover:border-slate-700 transition-all open:ring-1 open:ring-brand-500/30 open:border-brand-300 dark:open:border-brand-700">
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none select-none font-bold text-slate-900 dark:text-white text-base sm:text-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg">
                  <span class="faq-question text-left leading-snug">
                    {item.question}
                  </span>
                  <div class="shrink-0 w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                    <svg 
                      class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" 
                      fill="none" 
                      stroke="currentColor" 
                      viewBox="0 0 24 24" 
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </summary>

                <div class="faq-answer pt-4 mt-3 border-t border-slate-100 dark:border-slate-800/80 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  <div set:html={item.answerHtml} />
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}

      <!-- No Search Results Fallback -->
      <div id="faq-empty-state" class="hidden text-center py-12 space-y-3">
        <div class="text-4xl">🔍</div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">No questions matched your search</h3>
        <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto">
          Try adjusting your search terms or browse through the categories above. If your question is not listed, feel free to <a href="/contact" class="text-brand-600 dark:text-brand-400 underline font-semibold">contact us</a>.
        </p>
      </div>
    </div>

    <!-- Authoritative Official Resources Section -->
    <section class="bg-slate-50 dark:bg-slate-900/60 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-4">
      <div class="space-y-1">
        <div class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
          Primary Verification Sources
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
          Official RBT Certification & Testing Resources
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Because examination standards, scheduling policies, and fee structures can be updated by credentialing bodies, always verify individual testing rules directly through authoritative sources:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        {OFFICIAL_RESOURCES.map(res => (
          <a
            href={res.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 hover:border-brand-500 dark:hover:border-brand-500 hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-slate-900 dark:text-white font-bold text-sm group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                <span>{res.name}</span>
                <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                {res.description}
              </p>
            </div>
            <span class="text-[11px] font-semibold text-brand-600 dark:text-brand-400 pt-3 flex items-center gap-1">
              <span>Visit Official Site</span>
              <span>→</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Study Hub Next Steps Callout -->
    <section class="p-6 sm:p-8 rounded-3xl bg-gradient-to-tr from-brand-600 to-emerald-600 text-white space-y-4 shadow-lg text-center sm:text-left">
      <div class="space-y-1.5">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-200">
          Ready to Begin Studying?
        </span>
        <h2 class="text-2xl sm:text-3xl font-black">
          Start Your Free RBT Exam Preparation Today
        </h2>
        <p class="text-emerald-100 text-xs sm:text-sm max-w-2xl leading-relaxed">
          Access our full suite of scenario-based practice questions, 85-question timed mock exams, comprehensive domain study guides, and spaced repetition flashcards—100% free with no account required.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-2">
        <a
          href="/articles/how-to-pass-rbt-exam-30-day-study-plan"
          class="px-5 py-3 rounded-2xl bg-white text-brand-700 font-bold text-xs sm:text-sm shadow-md hover:bg-emerald-50 transition-colors"
        >
          📅 30-Day Study Plan
        </a>
        <a
          href="/mock-exams"
          class="px-5 py-3 rounded-2xl bg-brand-700/80 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm border border-white/20 transition-colors"
        >
          ⏱️ 85Q Timed Mock Exam
        </a>
        <a
          href="/study-guides"
          class="px-5 py-3 rounded-2xl bg-brand-700/80 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm border border-white/20 transition-colors"
        >
          📖 Pillar Study Guides
        </a>
        <a
          href="/glossary"
          class="px-5 py-3 rounded-2xl bg-brand-700/80 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm border border-white/20 transition-colors"
        >
          🗂️ RBT & ABA Glossary
        </a>
      </div>
    </section>

  </main>

  <!-- Lightweight, Accessible Client-Side Filter Script -->
  <script is:inline>
    const searchInput = document.getElementById('faq-search');
    const items = document.querySelectorAll('.faq-item');
    const categories = document.querySelectorAll('.faq-category');
    const emptyState = document.getElementById('faq-empty-state');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let totalVisible = 0;

        categories.forEach(cat => {
          let catVisible = 0;
          const catItems = cat.querySelectorAll('.faq-item');

          catItems.forEach(item => {
            const questionText = item.querySelector('.faq-question')?.textContent.toLowerCase() || '';
            const answerText = item.querySelector('.faq-answer')?.textContent.toLowerCase() || '';
            const isMatch = questionText.includes(query) || answerText.includes(query);

            if (isMatch) {
              item.style.display = '';
              catVisible++;
              totalVisible++;
              // Auto-open matching items if user has typed a search query
              if (query.length > 2) {
                item.setAttribute('open', '');
              }
            } else {
              item.style.display = 'none';
              if (query.length > 2) {
                item.removeAttribute('open');
              }
            }
          });

          // Show or hide whole category
          cat.style.display = catVisible > 0 ? '' : 'none';
        });

        if (emptyState) {
          emptyState.style.display = totalVisible === 0 ? 'block' : 'none';
        }
      });
    }
  </script>
</Layout>
