---
import Layout from '@/layouts/Layout.astro';
import { CMSService } from '@/lib/services/cms';
import { ArrowLeft, Clock, BookOpen, CheckCircle, HelpCircle, Layers } from 'lucide-react';

const { slug } = Astro.params;
const guide = slug ? CMSService.getStudyGuideBySlug(slug) : null;

if (!guide) {
  return Astro.redirect('/404');
}
---

<Layout title={`${guide.title} | RBT Study Guide`}>
  <div class="max-w-4xl mx-auto px-4 py-8 sm:py-12 space-y-8">
    <a href="/study-guides" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-brand-600 transition-colors">
      <ArrowLeft className="w-4 h-4" />
      <span>Back to All Study Guides</span>
    </a>

    <header class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="flex items-center gap-2 text-xs">
        <span class="px-3 py-1 rounded-full font-bold bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200">
          {guide.domain}
        </span>
        <span class="text-slate-400 flex items-center gap-1">
          <Clock className="w-3.5 h-3.5" /> {guide.readTimeMinutes} min read
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {guide.title}
      </h1>

      <p class="text-xs sm:text-base text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
        {guide.summary}
      </p>
    </header>

    {/* Section Breakdowns */}
    <div class="space-y-6">
      {guide.sections.map((section, idx) => (
        <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center text-xs font-bold">
              {idx + 1}
            </span>
            <span>{section.title}</span>
          </h2>

          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            {section.content}
          </p>

          {section.keyFormulasOrPoints && section.keyFormulasOrPoints.length > 0 && (
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-2">
              <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">High-Yield Exam Focus:</div>
              <ul class="space-y-1.5 text-xs text-slate-800 dark:text-slate-200">
                {section.keyFormulasOrPoints.map((point) => (
                  <li class="flex items-start gap-2">
                    <CheckCircle className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))}
    </div>

    {/* Related CTAs */}
    <div class="bg-slate-50 dark:bg-slate-800/60 rounded-3xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 space-y-4">
      <h2 class="text-sm font-bold text-slate-900 dark:text-white">Practice this domain now:</h2>
      <div class="flex flex-wrap gap-3">
        <a
          href="/practice-questions"
          class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-md flex items-center gap-1.5"
        >
          <HelpCircle className="w-4 h-4" />
          <span>Practice Domain Questions</span>
        </a>
        <a
          href="/flashcards"
          class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold shadow-md flex items-center gap-1.5"
        >
          <Layers className="w-4 h-4" />
          <span>Review Flashcards</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
