---
import Layout from '@/layouts/Layout.astro';
import ReviewDate from '@/components/ReviewDate.astro';
import { INITIAL_STUDY_GUIDES } from '@/data/mock-data';
import { BookOpen, Clock, ArrowRight, CheckCircle, HelpCircle, Layers, ShieldCheck, Compass } from 'lucide-react';

const title = "RBT Study Guides & High-Yield Domain Cheatsheets (3rd ed. TCO)";
const description = "Comprehensive, free educational study guides for the RBT examination aligned with the current BACB RBT Test Content Outline (3rd ed.). Covers Domains A through F.";
const canonicalUrl = "https://rbtpracticeexam.xyz/study-guides";

const hubJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": "RBTPracticeExam.xyz",
    "url": "https://rbtpracticeexam.xyz"
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": INITIAL_STUDY_GUIDES.map((guide, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": guide.title,
      "url": `https://rbtpracticeexam.xyz/study-guides/${guide.slug}`
    }))
  }
};
---

<Layout 
  title={`${title} | RBTPracticeExam.xyz`}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(hubJsonLd)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 animate-fadeIn">
    {/* Page Header */}
    <header class="border-b border-slate-200 dark:border-slate-800 pb-8 space-y-4">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
        <Compass className="w-4 h-4" />
        <span>RBT Test Content Outline (3rd ed.) Curriculum Hub</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        RBT Study Guides & Pillar Cheatsheets
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Comprehensive, in-depth educational study guides designed to prepare candidates for the Registered Behavior Technician® certification exam. Master all six domains with operational definitions, clinical decision tables, common pitfalls, and targeted FAQs.
      </p>

      {/* Independent Notice */}
      <div class="p-4 rounded-2xl bg-amber-50/60 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-xs text-amber-900 dark:text-amber-300 flex items-start gap-3">
        <ShieldCheck className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
        <div class="space-y-1">
          <span class="font-bold">Independent Educational Prep Notice:</span>
          <p class="leading-relaxed text-amber-800 dark:text-amber-400">
            RBTPracticeExam.xyz is an independent educational test-preparation platform and is not affiliated with, sponsored by, or endorsed by the Behavior Analyst Certification Board® (BACB®). RBT®, Registered Behavior Technician®, and BCBA® are registered trademarks of the BACB®.
          </p>
        </div>
      </div>
    </header>

    {/* Study Guides Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {INITIAL_STUDY_GUIDES.map((guide) => (
        <article class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:shadow-md hover:border-amber-400/60 dark:hover:border-amber-600/60 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                {guide.domain}
              </span>
              <span class="text-xs text-slate-400 dark:text-slate-500 flex items-center gap-1">
                <Clock className="w-3.5 h-3.5" /> {guide.readTimeMinutes} min read
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug">
                <a href={`/study-guides/${guide.slug}`} class="focus:outline-none">
                  {guide.title}
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                {guide.summary}
              </p>
            </div>

            {/* Key Section Highlights */}
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
              <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                Core Sections Included:
              </div>
              <ul class="space-y-1 text-xs text-slate-600 dark:text-slate-300">
                {guide.sections.slice(0, 4).map((sec) => (
                  <li class="flex items-start gap-1.5 truncate">
                    <CheckCircle className="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
                    <span class="truncate">{sec.title}</span>
                  </li>
                ))}
                {guide.sections.length > 4 && (
                  <li class="text-[11px] text-slate-400 dark:text-slate-500 pl-5">
                    + {guide.sections.length - 4} additional clinical sections & FAQs
                  </li>
                )}
              </ul>
            </div>
          </div>

          <div class="pt-3">
            <ReviewDate 
              publishedAt={guide.publishedAt} 
              updatedAt={guide.updatedAt} 
              lastReviewed={guide.lastReviewed} 
            />
          </div>

          <div class="pt-4 mt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
            <a
              href={`/study-guides/${guide.slug}`}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold hover:bg-amber-600 dark:hover:bg-amber-400 dark:hover:text-slate-950 transition-colors shadow-sm"
            >
              <span>Read Full Guide</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>

            <div class="flex items-center gap-2">
              <a
                href={`/practice-questions?domain=${encodeURIComponent(guide.domain)}`}
                title="Practice questions for this domain"
                class="p-2 rounded-lg text-slate-500 hover:text-brand-600 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              >
                <HelpCircle className="w-4 h-4" />
              </a>
              <a
                href="/flashcards"
                title="Review flashcards"
                class="p-2 rounded-lg text-slate-500 hover:text-brand-600 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              >
                <Layers className="w-4 h-4" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Supplementary Study Resources Banner */}
    <div class="rounded-3xl bg-slate-100 dark:bg-slate-800/60 p-6 sm:p-8 border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
          Looking for discrete curriculum topic breakdowns?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl">
          Review our 16 granular curriculum topics spanning Continuous Measurement, DTT, Differential Reinforcement, Extinction, Session Notes, and Professional Ethics.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/topics"
          class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-md transition-colors"
        >
          Explore All Topics Directory →
        </a>
        <a
          href="/glossary"
          class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-md transition-colors"
        >
          A–Z Glossary →
        </a>
        <a
          href="/mock-exams"
          class="px-5 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 text-xs font-bold hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
        >
          Take Timed Mock Exam
        </a>
      </div>

    </div>
  </div>
</Layout>
