---
import Layout from '@/layouts/Layout.astro';
import { INITIAL_STUDY_GUIDES } from '@/data/mock-data';
---

<Layout title="RBT Study Guides & High-Yield Cheatsheets">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="text-xs font-bold uppercase tracking-wider text-amber-600">High-Yield Reference</div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">RBT Study Guides & Cheatsheets</h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl">
        Concise summaries of continuous measurement, discontinuous time sampling, differential reinforcement, and ethics.
      </p>
    </div>

    <div class="space-y-6">
      {INITIAL_STUDY_GUIDES.map((guide) => (
        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-6 shadow-sm">
          <div class="space-y-1">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200">
              {guide.domain}
            </span>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white pt-1">{guide.title}</h2>
            <p class="text-xs text-slate-500">{guide.readTimeMinutes} min read • {guide.summary}</p>
          </div>

          <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
            {guide.sections.map((sec) => (
              <div class="space-y-2">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">{sec.title}</h3>
                <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{sec.content}</p>
                {sec.keyFormulasOrPoints && (
                  <div class="p-3.5 rounded-xl bg-amber-50/70 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-xs space-y-1">
                    {sec.keyFormulasOrPoints.map((pt) => (
                      <div class="font-mono text-slate-900 dark:text-slate-100">• {pt}</div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
