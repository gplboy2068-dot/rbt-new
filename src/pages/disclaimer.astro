---
import Layout from '@/layouts/Layout.astro';
---

<Layout 
  title="Disclaimer & Trademark Notice — RBT Practice Exam"
  description="Educational and trademark disclaimer for rbtpracticeexam.xyz regarding the Behavior Analyst Certification Board (BACB) and Registered Behavior Technician (RBT) credentials."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 animate-fadeIn">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
        Compliance & Legal
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Disclaimer & Trademark Notice
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        rbtpracticeexam.xyz • Independent Educational Resource
      </p>
    </div>

    <div class="space-y-6 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
      <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900 rounded-3xl p-6 sm:p-8 space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-amber-900 dark:text-amber-200 flex items-center gap-2">
          <span>⚠️ Official BACB® Trademark Notice</span>
        </h2>
        <p class="text-amber-950 dark:text-amber-300/90 text-xs sm:text-sm leading-relaxed">
          <strong>BACB®</strong>, <strong>Behavior Analyst Certification Board®</strong>, <strong>RBT®</strong>, and <strong>Registered Behavior Technician®</strong> are registered trademarks of the Behavior Analyst Certification Board, Inc. (BACB). 
        </p>
        <p class="text-amber-900 dark:text-amber-300 text-xs leading-relaxed">
          <strong>RBT Practice Exam</strong> (<code>rbtpracticeexam.xyz</code>) is an independent preparatory platform and is <strong>NOT</strong> affiliated with, endorsed by, sponsored by, or officially connected with the Behavior Analyst Certification Board, Inc. (BACB).
        </p>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Educational Scope & No Guarantee</h2>
        <p>
          Our practice questions, mock examinations, flashcard decks, and AI tutor explanations are developed for independent study based on publicly available BACB task list outlines (2nd & 6th Editions). Completing practice tests on this website does not guarantee passing the official BACB certification examination.
        </p>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Clinical Advice Disclaimer</h2>
        <p>
          The materials on this platform are for test preparation and behavior technician knowledge drills only. They are not intended as clinical behavioral prescriptions, psychological counseling, or medical supervision advice. Direct therapy should always follow the supervising BCBA/BCaBA clinical treatment plan.
        </p>
      </div>
    </div>
  </div>
</Layout>
