---
import Layout from '@/layouts/Layout.astro';
import { CMSService } from '@/lib/services/cms';
import { 
  ArrowLeft, 
  Clock, 
  User, 
  HelpCircle, 
  Layers, 
  BookOpen, 
  ChevronRight, 
  CheckCircle, 
  List, 
  Share2, 
  ShieldCheck, 
  Sparkles,
  ExternalLink,
  Calendar,
  Compass
} from 'lucide-react';
import { marked } from 'marked';

const { slug } = Astro.params;
const article = slug ? CMSService.getArticleBySlug(slug) : null;

if (!article) {
  return Astro.redirect('/404');
}

// Configure marked with custom heading renderer to inject IDs for TOC
const renderer = new marked.Renderer();
renderer.heading = function ({ text, depth }) {
  const cleanId = text
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-');
  return `<h${depth} id="${cleanId}">${text}</h${depth}>`;
};

marked.use({ renderer, gfm: true, breaks: false });

// Compile markdown content to HTML
const articleHtml = await marked.parse(article.content);

// Extract Table of Contents from H2 headings
const tocMatches = Array.from(article.content.matchAll(/^##\s+(.+)$/gm));
const tableOfContents = tocMatches.map((m) => {
  const rawText = m[1].trim();
  const id = rawText
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-');
  return { id, title: rawText };
});

const currentUrl = `https://rbtpracticeexam.xyz/articles/${article.slug}`;

// Determine domain practice link and label
const isDomainSpecific = article.domain.includes('Domain');
const domainPracticeUrl = article.domain.includes('Domain A')
  ? '/practice-questions?domain=A%3A%20Data%20Collection%20and%20Graphing'
  : article.domain.includes('Domain D')
  ? '/practice-questions?domain=D%3A%20Behavior%20Reduction'
  : '/practice-questions';

const practiceButtonLabel = isDomainSpecific
  ? `Practice ${article.domain.split('—')[0]?.trim()} Questions`
  : 'Practice All Exam Questions';

// Schema.org Article & Breadcrumbs
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.seoDescription || article.excerpt,
  "url": currentUrl,
  "inLanguage": "en-US",
  "author": {
    "@type": "Organization",
    "name": "RBTPracticeExam.xyz Educational Content Team",
    "url": "https://rbtpracticeexam.xyz/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "RBTPracticeExam.xyz",
    "url": "https://rbtpracticeexam.xyz"
  },
  "about": {
    "@type": "EducationalOccupationalCredential",
    "name": "Registered Behavior Technician (RBT)",
    "credentialCategory": "Certification"
  },
  "datePublished": article.publishedAt,
  "dateModified": article.updatedAt
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://rbtpracticeexam.xyz"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Articles",
      "item": "https://rbtpracticeexam.xyz/articles"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.title,
      "item": currentUrl
    }
  ]
};
---

<Layout 
  title={`${article.seoTitle || article.title} | RBTPracticeExam.xyz`}
  description={article.seoDescription || article.excerpt}
  canonicalUrl={currentUrl}
>
  {/* JSON-LD Schemas */}
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  {/* Reading Progress Bar (Fixed Top) */}
  <div 
    id="reading-progress" 
    class="fixed top-0 left-0 h-1 bg-gradient-to-r from-amber-500 via-brand-500 to-teal-500 z-50 transition-all duration-75"
    style="width: 0%"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 animate-fadeIn">
    {/* Breadcrumbs Navigation */}
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
      <ChevronRight className="w-3.5 h-3.5 text-slate-400 shrink-0" />
      <a href="/articles" class="hover:text-brand-600 transition-colors">Articles</a>
      <ChevronRight className="w-3.5 h-3.5 text-slate-400 shrink-0" />
      <span class="text-slate-700 dark:text-slate-200 font-semibold truncate max-w-xs sm:max-w-md">{article.title}</span>
    </nav>

    {/* Back link */}
    <div>
      <a 
        href="/articles" 
        class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-brand-600 transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Back to All Articles</span>
      </a>
    </div>

    {/* Hero Article Header */}
    <header class="bg-gradient-to-b from-slate-50 to-white dark:from-slate-900/80 dark:to-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-sm space-y-6">
      <div class="flex flex-wrap items-center gap-2.5 text-xs">
        <span class="px-3.5 py-1 rounded-full font-bold bg-amber-50 text-amber-900 dark:bg-amber-950/70 dark:text-amber-300 border border-amber-200 dark:border-amber-800 flex items-center gap-1.5 shadow-2xs">
          <Sparkles className="w-3 h-3 text-amber-600" />
          <span>{article.domain}</span>
        </span>
        <span class="px-3 py-1 rounded-full font-bold bg-blue-50 text-blue-900 dark:bg-blue-950/70 dark:text-blue-300 border border-blue-200 dark:border-blue-800 flex items-center gap-1.5 shadow-2xs">
          <ShieldCheck className="w-3.5 h-3.5 text-blue-600" />
          <span>RBT Test Content Outline (3rd ed.) Aligned</span>
        </span>
        <span class="px-3 py-1 rounded-full font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center gap-1.5 border border-slate-200 dark:border-slate-700 shadow-2xs">
          <Clock className="w-3.5 h-3.5 text-slate-500" />
          <span>{article.readTimeMinutes} min read</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        {article.title}
      </h1>

      <div class="border-l-4 border-amber-500 pl-4 py-1">
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-normal leading-relaxed italic">
          {article.excerpt}
        </p>
      </div>

      {/* Author & Credential Attribution */}
      <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex flex-wrap items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300 font-bold flex items-center justify-center shrink-0 border border-brand-200">
            RBT
          </div>
          <div>
            <div class="font-bold text-slate-900 dark:text-white">{article.author}</div>
            <div class="text-[11px] text-slate-400">Technical Architecture: Firoz Khan (FK Digital Media)</div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-slate-400">
          <span class="flex items-center gap-1">
            <Calendar className="w-3.5 h-3.5" />
            <span>Published January 2026</span>
          </span>
          <span>•</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
            <CheckCircle className="w-3.5 h-3.5" />
            <span>Verified 3rd ed. TCO</span>
          </span>
        </div>
      </div>
    </header>

    {/* Main Content Grid: 8 Cols Article + 4 Cols Sidebar on LG */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      {/* Left Column: Article Prose */}
      <div class="lg:col-span-8 space-y-8">
        {/* Mobile Quick Jump (Accordion) */}
        {tableOfContents.length > 0 && (
          <details class="lg:hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm group">
            <summary class="flex items-center justify-between text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer list-none select-none">
              <span class="flex items-center gap-2">
                <List className="w-4 h-4 text-brand-600" />
                <span>Jump to Section ({tableOfContents.length} topics)</span>
              </span>
              <ChevronRight className="w-4 h-4 text-slate-400 group-open:rotate-90 transition-transform" />
            </summary>
            <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
              {tableOfContents.map((item, idx) => (
                <a
                  href={`#${item.id}`}
                  class="block text-xs text-slate-600 dark:text-slate-400 hover:text-brand-600 py-1 font-medium transition-colors"
                >
                  <span class="text-slate-400 font-mono text-[11px] mr-1.5">{idx + 1}.</span>
                  <span>{item.title}</span>
                </a>
              ))}
            </div>
          </details>
        )}

        {/* Clean Article Content Card */}
        <article class="article-prose bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-12 shadow-sm">
          <div set:html={articleHtml} />
        </article>

        {/* Bottom Educational Action Hub */}
        <div class="bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 text-white rounded-3xl p-6 sm:p-10 space-y-5 shadow-xl border border-slate-800">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 uppercase tracking-wider">
              <Compass className="w-3.5 h-3.5" />
              <span>Next Steps in Your Learning Journey</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-white">Ready to Put This Knowledge Into Practice?</h2>
            <p class="text-xs sm:text-sm text-slate-300 max-w-xl leading-relaxed">
              Consolidate what you just learned with our free domain practice banks, spaced-repetition flashcards, and full-length timed mock exams.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href={domainPracticeUrl}
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs sm:text-sm font-bold shadow-md flex items-center gap-2 transition-all hover:scale-[1.02]"
            >
              <HelpCircle className="w-4 h-4" />
              <span>{practiceButtonLabel}</span>
            </a>
            <a
              href="/flashcards"
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs sm:text-sm font-bold shadow-md flex items-center gap-2 border border-slate-700 transition-all hover:scale-[1.02]"
            >
              <Layers className="w-4 h-4" />
              <span>Study Flashcards</span>
            </a>
            <a
              href="/mock-exams"
              class="px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs sm:text-sm font-bold shadow-md flex items-center gap-2 transition-all hover:scale-[1.02] ml-auto"
            >
              <span>Take Full Mock Exam →</span>
            </a>
          </div>
        </div>
      </div>

      {/* Right Column: Sticky Sidebar on Desktop */}
      <aside class="hidden lg:block lg:col-span-4 sticky top-24 self-start space-y-6">
        {/* Table of Contents Card */}
        {tableOfContents.length > 0 && (
          <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-2 text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider pb-3 border-b border-slate-100 dark:border-slate-800">
              <BookOpen className="w-4 h-4 text-brand-600" />
              <span>Table of Contents</span>
            </div>

            <nav class="space-y-1 max-h-[60vh] overflow-y-auto pr-1">
              {tableOfContents.map((item, idx) => (
                <a
                  href={`#${item.id}`}
                  class="group flex items-start gap-2 text-xs text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 py-1.5 px-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors leading-snug"
                >
                  <span class="text-slate-400 font-mono text-[11px] shrink-0 pt-0.5">{idx + 1}.</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">{item.title}</span>
                </a>
              ))}
            </nav>
          </div>
        )}

        {/* Quick Practice Card */}
        <div class="bg-gradient-to-br from-amber-50/80 to-white dark:from-slate-900 dark:to-amber-950/20 rounded-3xl border border-amber-200/80 dark:border-amber-900/40 p-6 shadow-sm space-y-4">
          <div class="space-y-1">
            <div class="text-[11px] font-bold text-amber-800 dark:text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
              <Sparkles className="w-3.5 h-3.5 text-amber-600" />
              <span>Instant Diagnostic Drill</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              Test your understanding now
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Don't just read—test yourself immediately to build long-term retention.
            </p>
          </div>

          <div class="space-y-2 pt-1">
            <a
              href={domainPracticeUrl}
              class="w-full px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-xs flex items-center justify-between transition-colors"
            >
              <span>Practice Questions</span>
              <ChevronRight className="w-4 h-4" />
            </a>
            <a
              href="/glossary"
              class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-bold border border-slate-200 dark:border-slate-700 hover:border-brand-500 flex items-center justify-between transition-colors"
            >
              <span>Explore A–Z Glossary</span>
              <ChevronRight className="w-4 h-4" />
            </a>
            <a
              href="/study-guides"
              class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-bold border border-slate-200 dark:border-slate-700 hover:border-brand-500 flex items-center justify-between transition-colors"
            >
              <span>Pillar Study Guides</span>
              <ChevronRight className="w-4 h-4" />
            </a>
          </div>
        </div>

        {/* Regulatory & Independence Notice */}
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400 space-y-2 leading-relaxed">
          <div class="font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <ShieldCheck className="w-3.5 h-3.5 text-slate-400" />
            <span>Independent Prep Disclaimer</span>
          </div>
          <p>
            RBTPracticeExam.xyz is an independent educational platform. Materials are aligned with the BACB RBT Test Content Outline (3rd ed.) for educational purposes only. Not affiliated with or endorsed by the Behavior Analyst Certification Board.
          </p>
        </div>
      </aside>
    </div>
  </div>

  {/* Client-Side Reading Progress Script */}
  <script is:inline>
    function updateProgress() {
      const bar = document.getElementById('reading-progress');
      if (!bar) return;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (totalHeight <= 0) return;
      const progress = (window.scrollY / totalHeight) * 100;
      bar.style.width = Math.min(100, Math.max(0, progress)) + '%';
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  </script>
</Layout>

{/* Comprehensive Scoped Styles for Elevated Article Typography */}
<style is:global>
  /* Headings H2 */
  .article-prose h2 {
    font-size: 1.65rem;
    font-weight: 900;
    color: #0f172a;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
    scroll-margin-top: 6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .dark .article-prose h2 {
    color: #ffffff;
    border-top-color: #1e293b;
  }
  .article-prose h2:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .article-prose h2::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.25rem;
    background-color: #f59e0b;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  /* Headings H3 */
  .article-prose h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2rem;
    margin-bottom: 0.85rem;
    scroll-margin-top: 6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    letter-spacing: -0.01em;
  }
  .dark .article-prose h3 {
    color: #f1f5f9;
  }

  /* Paragraphs */
  .article-prose p {
    font-size: 1.025rem;
    line-height: 1.85;
    color: #334155;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .dark .article-prose p {
    color: #cbd5e1;
  }

  /* Ordered Lists */
  .article-prose ol {
    list-style-type: decimal;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: #334155;
    font-size: 1rem;
    line-height: 1.8;
  }
  .dark .article-prose ol {
    color: #cbd5e1;
  }
  .article-prose ol > li {
    margin-top: 0.65rem;
    margin-bottom: 0.65rem;
    padding-left: 0.35rem;
  }

  /* Unordered Lists */
  .article-prose ul {
    list-style-type: disc;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: #334155;
    font-size: 1rem;
    line-height: 1.8;
  }
  .dark .article-prose ul {
    color: #cbd5e1;
  }
  .article-prose ul > li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    padding-left: 0.35rem;
  }

  /* Bold Text */
  .article-prose strong {
    font-weight: 700;
    color: #0f172a;
  }
  .dark .article-prose strong {
    color: #ffffff;
  }

  /* Tables */
  .article-prose table {
    width: 100%;
    text-align: left;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin-top: 1.75rem;
    margin-bottom: 1.75rem;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
  }
  .dark .article-prose table {
    border-color: #1e293b;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.3);
  }
  .article-prose thead tr {
    background-color: #f1f5f9;
    border-bottom: 2px solid #cbd5e1;
  }
  .dark .article-prose thead tr {
    background-color: #1e293b;
    border-bottom-color: #334155;
  }
  .article-prose thead th {
    padding: 0.85rem 1rem;
    font-weight: 800;
    color: #0f172a;
    font-size: 0.775rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .dark .article-prose thead th {
    color: #ffffff;
  }
  .article-prose tbody tr {
    border-top: 1px solid #e2e8f0;
    transition: background-color 0.15s ease;
  }
  .dark .article-prose tbody tr {
    border-top-color: #1e293b;
  }
  .article-prose tbody tr:hover {
    background-color: #fffbeb;
  }
  .dark .article-prose tbody tr:hover {
    background-color: #1e293b66;
  }
  .article-prose tbody td {
    padding: 0.85rem 1rem;
    color: #334155;
    line-height: 1.65;
    vertical-align: top;
  }
  .dark .article-prose tbody td {
    color: #cbd5e1;
  }

  /* Blockquotes / Callout Cards */
  .article-prose blockquote {
    padding: 1.25rem 1.5rem;
    margin: 1.75rem 0;
    background-color: #fffbeb;
    border-left: 4px solid #f59e0b;
    border-radius: 1rem;
    color: #1e293b;
    font-size: 0.95rem;
    line-height: 1.75;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
  }
  .dark .article-prose blockquote {
    background-color: #451a0333;
    border-left-color: #d97706;
    color: #fef3c7;
  }
  .article-prose blockquote p {
    margin: 0.5rem 0;
    color: inherit;
  }
  .article-prose blockquote p:first-of-type {
    margin-top: 0;
  }
  .article-prose blockquote p:last-of-type {
    margin-bottom: 0;
  }

  /* Links */
  .article-prose a {
    font-weight: 700;
    color: #b45309;
    text-decoration: underline;
    text-decoration-color: #fde68a;
    text-underline-offset: 4px;
    transition: all 0.15s ease;
  }
  .article-prose a:hover {
    color: #92400e;
    text-decoration-color: #f59e0b;
  }
  .dark .article-prose a {
    color: #fbbf24;
    text-decoration-color: #78350f;
  }
  .dark .article-prose a:hover {
    color: #fde68a;
    text-decoration-color: #fbbf24;
  }

  /* Code Blocks */
  .article-prose pre {
    background-color: #020617;
    color: #f8fafc;
    padding: 1.25rem;
    border-radius: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    line-height: 1.7;
    border: 1px solid #1e293b;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Inline Code */
  .article-prose code:not(pre code) {
    background-color: #f1f5f9;
