---
import Layout from '@/layouts/Layout.astro';
import { CMSService } from '@/lib/services/cms';
import { ArrowLeft, Clock, User, HelpCircle, Layers, BookOpen, ExternalLink, ChevronRight, CheckCircle } from 'lucide-react';

const { slug } = Astro.params;
const article = slug ? CMSService.getArticleBySlug(slug) : null;

if (!article) {
  return Astro.redirect('/404');
}

// Markdown Block Parser for Educational Articles
interface ContentBlock {
  type: 'h2' | 'h3' | 'paragraph' | 'table' | 'list' | 'blockquote' | 'codeblock' | 'hr';
  id?: string;
  text?: string;
  ordered?: boolean;
  items?: string[];
  headers?: string[];
  rows?: string[][];
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-');
}

function parseArticleMarkdown(content: string): ContentBlock[] {
  // Normalize newlines
  const rawSections = content.replace(/\r\n/g, '\n').split(/\n{2,}/);
  const blocks: ContentBlock[] = [];

  for (const raw of rawSections) {
    const trimmed = raw.trim();
    if (!trimmed) continue;

    // Horizontal Rule
    if (trimmed === '---') {
      blocks.push({ type: 'hr' });
      continue;
    }

    // Heading 2
    if (trimmed.startsWith('## ')) {
      const headingText = trimmed.replace(/^##\s+/, '').trim();
      blocks.push({
        type: 'h2',
        text: headingText,
        id: slugify(headingText),
      });
      continue;
    }

    // Heading 3
    if (trimmed.startsWith('### ')) {
      const headingText = trimmed.replace(/^###\s+/, '').trim();
      blocks.push({
        type: 'h3',
        text: headingText,
        id: slugify(headingText),
      });
      continue;
    }

    // Blockquote
    if (trimmed.startsWith('>')) {
      const bqText = trimmed
        .split('\n')
        .map((l) => l.replace(/^>\s?/, '').trim())
        .join(' ');
      blocks.push({
        type: 'blockquote',
        text: bqText,
      });
      continue;
    }

    // Codeblock / Preformatted Box
    if (trimmed.startsWith('```') && trimmed.endsWith('```')) {
      const codeLines = trimmed.split('\n').slice(1, -1).join('\n');
      blocks.push({
        type: 'codeblock',
        text: codeLines,
      });
      continue;
    }

    // Markdown Table
    if (trimmed.includes('|') && trimmed.includes('\n|')) {
      const tableLines = trimmed.split('\n').filter((l) => l.trim().startsWith('|'));
      if (tableLines.length >= 2) {
        const headerCols = tableLines[0]
          .split('|')
          .map((c) => c.trim())
          .filter(Boolean);
        // Exclude separator line (e.g. | :--- | :--- |)
        const rowLines = tableLines.slice(1).filter((l) => !/^[|\s:-]+$/.test(l.trim()));
        const rows = rowLines.map((r) =>
          r
            .split('|')
            .map((c) => c.trim())
            .filter(Boolean)
        );
        blocks.push({
          type: 'table',
          headers: headerCols,
          rows,
        });
        continue;
      }
    }

    const lines = trimmed.split('\n');

    // Unordered List
    if (lines.length > 0 && lines.every((l) => l.trim().startsWith('- ') || l.trim().startsWith('* '))) {
      blocks.push({
        type: 'list',
        ordered: false,
        items: lines.map((l) => l.replace(/^[-*]\s+/, '').trim()),
      });
      continue;
    }

    // Ordered List
    if (lines.length > 0 && lines.every((l) => /^\d+\.\s+/.test(l.trim()))) {
      blocks.push({
        type: 'list',
        ordered: true,
        items: lines.map((l) => l.replace(/^\d+\.\s+/, '').trim()),
      });
      continue;
    }

    // Standard Paragraph
    blocks.push({
      type: 'paragraph',
      text: trimmed,
    });
  }

  return blocks;
}

// Inline formatting helper: Bold, Italics, Code, Markdown Links
function formatInline(text: string): string {
  return text
    // Links: [label](url)
    .replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      '<a href="$2" class="font-bold text-amber-700 dark:text-amber-400 underline decoration-amber-300 dark:decoration-amber-700 hover:text-amber-800 dark:hover:text-amber-300 transition-colors">$1</a>'
    )
    // Bold: **text**
    .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
    // Italics: *text*
    .replace(/\*([^*]+)\*/g, '<em class="italic">$1</em>')
    // Inline code: `code`
    .replace(
      /`([^`]+)`/g,
      '<code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs font-mono text-amber-700 dark:text-amber-400 font-semibold">$1</code>'
    );
}

const blocks = parseArticleMarkdown(article.content);
const currentUrl = `https://rbtpracticeexam.xyz/articles/${article.slug}`;

// Schema.org Article & Breadcrumbs
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.seoDescription || article.excerpt,
  "url": currentUrl,
  "inLanguage": "en-US",
  "author": {
    "@type": "Organization",
    "name": "RBTPracticeExam.xyz Educational Prep Team",
    "url": "https://rbtpracticeexam.xyz/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "RBTPracticeExam.xyz",
    "url": "https://rbtpracticeexam.xyz"
  },
  "about": {
    "@type": "EducationalOccupationalCredential",
    "name": "Registered Behavior Technician (RBT)",
    "credentialCategory": "Certification"
  },
  "datePublished": article.publishedAt,
  "dateModified": article.updatedAt
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://rbtpracticeexam.xyz"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Articles",
      "item": "https://rbtpracticeexam.xyz/articles"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.title,
      "item": currentUrl
    }
  ]
};
---

<Layout 
  title={`${article.seoTitle || article.title} | RBTPracticeExam.xyz`}
  description={article.seoDescription || article.excerpt}
  canonicalUrl={currentUrl}
>
  {/* JSON-LD Schemas */}
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-4xl mx-auto px-4 py-8 sm:py-12 space-y-8 animate-fadeIn">
    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
      <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
      <a href="/articles" class="hover:text-brand-600 transition-colors">Articles</a>
      <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
      <span class="text-slate-700 dark:text-slate-200 font-semibold truncate max-w-xs sm:max-w-md">{article.title}</span>
    </nav>

    {/* Back link */}
    <div>
      <a 
        href="/articles" 
        class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-brand-600 transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Back to All Articles</span>
      </a>
    </div>

    {/* Header */}
    <header class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="px-3 py-1 rounded-full font-bold bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
          {article.domain}
        </span>
        <span class="px-2.5 py-1 rounded-full font-bold bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
          RBT Test Content Outline (3rd ed.) Aligned
        </span>
        <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1">
          <Clock className="w-3.5 h-3.5" /> {article.readTimeMinutes} min read
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {article.title}
      </h1>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
        {article.excerpt}
      </p>

      <div class="text-xs text-slate-400 flex flex-wrap items-center gap-3 pt-2">
        <span class="flex items-center gap-1.5">
          <User className="w-4 h-4 text-slate-500" />
          <span>Curated by <strong>{article.author}</strong></span>
        </span>
        <span>•</span>
        <span>Technical & Platform Architect: <strong>Firoz Khan</strong> (FK Digital Media)</span>
      </div>
    </header>

    {/* Structured Article Prose */}
    <article class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-sm space-y-6 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
      {blocks.map((block) => {
        if (block.type === 'h2') {
          return (
            <h2 id={block.id} class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white pt-6 border-t border-slate-100 dark:border-slate-800 first:border-0 first:pt-0 scroll-mt-20">
              {block.text}
            </h2>
          );
        }

        if (block.type === 'h3') {
          return (
            <h3 id={block.id} class="text-base sm:text-lg font-bold text-slate-900 dark:text-white pt-3 scroll-mt-20">
              {block.text}
            </h3>
          );
        }

        if (block.type === 'blockquote') {
          return (
            <div class="p-4 sm:p-5 rounded-2xl bg-amber-50/70 dark:bg-amber-950/40 border-l-4 border-amber-500 text-xs sm:text-sm text-slate-800 dark:text-slate-200 leading-relaxed space-y-1.5 shadow-2xs" set:html={formatInline(block.text || '')} />
          );
        }

        if (block.type === 'codeblock') {
          return (
            <div class="p-4 rounded-2xl bg-slate-900 text-slate-100 font-mono text-xs overflow-x-auto my-3 leading-relaxed whitespace-pre">
              {block.text}
            </div>
          );
        }

        if (block.type === 'hr') {
          return <hr class="border-slate-200 dark:border-slate-800 my-6" />;
        }

        if (block.type === 'table') {
          return (
            <div class="overflow-x-auto my-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xs">
              <table class="w-full text-left border-collapse text-xs sm:text-sm">
                <thead>
                  <tr class="bg-slate-100 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-700">
                    {block.headers?.map((h) => (
                      <th class="p-3.5 font-bold text-slate-900 dark:text-slate-100 whitespace-nowrap" set:html={formatInline(h)} />
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                  {block.rows?.map((row) => (
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                      {row.map((cell) => (
                        <td class="p-3.5 text-slate-700 dark:text-slate-300 align-top leading-relaxed" set:html={formatInline(cell)} />
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
        }

        if (block.type === 'list') {
          if (block.ordered) {
            return (
              <ol class="list-decimal list-outside space-y-2 pl-5 my-3 text-slate-700 dark:text-slate-300 leading-relaxed">
                {block.items?.map((it) => (
                  <li set:html={formatInline(it)} />
                ))}
              </ol>
            );
          }
          return (
            <ul class="list-disc list-outside space-y-2 pl-5 my-3 text-slate-700 dark:text-slate-300 leading-relaxed">
              {block.items?.map((it) => (
                <li set:html={formatInline(it)} />
              ))}
            </ul>
          );
        }

        return (
          <p class="leading-relaxed" set:html={formatInline(block.text || '')} />
        );
      })}
    </article>

    {/* Related Action & Study Hub */}
    <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-6 sm:p-8 space-y-4 shadow-xl border border-slate-800">
      <div class="space-y-1">
        <h2 class="text-base sm:text-lg font-bold text-white">Test Your Conceptual Mastery</h2>
        <p class="text-xs text-slate-400">Put theory into practice with our 100% free interactive question banks, curriculum topics, and mock exams.</p>
      </div>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/practice-questions"
          class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-md flex items-center gap-1.5 transition-all"
        >
          <HelpCircle className="w-4 h-4" />
          <span>Practice Question Bank</span>
        </a>
        <a
          href="/study-guides"
          class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold shadow-md flex items-center gap-1.5 border border-slate-700 transition-all"
        >
          <BookOpen className="w-4 h-4" />
          <span>Domain Pillar Guides</span>
        </a>
        <a
          href="/glossary"
          class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-bold shadow-md flex items-center gap-1.5 border border-slate-700 transition-all"
        >
          <span>A–Z Glossary →</span>
        </a>
        <a
          href="/mock-exams"
          class="px-5 py-2.5 rounded-xl bg-transparent hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-bold flex items-center gap-1.5 border border-slate-700 transition-all ml-auto"
        >
          <span>Timed Mock Exam →</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
