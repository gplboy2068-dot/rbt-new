---
import Layout from '@/layouts/Layout.astro';
import ReviewDate from '@/components/ReviewDate.astro';
import GlossaryIsland from '@/components/GlossaryIsland';
import { GLOSSARY_TERMS } from '@/data/glossary-data';
import { BookOpen, ShieldCheck, ChevronRight, HelpCircle, Layers, Compass, ExternalLink } from 'lucide-react';

const title = "RBT & ABA Glossary: Key Behavioral Terms Explained";
const description = "Comprehensive, educational A–Z glossary of Registered Behavior Technician (RBT) and Applied Behavior Analysis (ABA) terms. Master operational definitions, clinical examples, and exam pitfalls.";
const canonicalUrl = "https://rbtpracticeexam.xyz/glossary";

// Structured Data: DefinedTermSet & Breadcrumbs
const termSetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "RBT & ABA Behavioral Terminology Glossary",
  "description": description,
  "url": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": "RBTPracticeExam.xyz",
    "url": "https://rbtpracticeexam.xyz"
  },
  "hasDefinedTerm": GLOSSARY_TERMS.slice(0, 30).map((t) => ({
    "@type": "DefinedTerm",
    "name": t.term,
    "description": t.shortDefinition,
    "termCode": t.slug,
    "url": `${canonicalUrl}#${t.slug}`,
    "inDefinedTermSet": canonicalUrl
  }))
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://rbtpracticeexam.xyz"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Glossary",
      "item": canonicalUrl
    }
  ]
};
---

<Layout 
  title={`${title} | RBTPracticeExam.xyz`}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(termSetJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 animate-fadeIn">
    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
      <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
      <span class="text-slate-800 dark:text-slate-200 font-semibold">Glossary</span>
    </nav>

    {/* Header */}
    <header class="border-b border-slate-200 dark:border-slate-800 pb-8 space-y-4">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
        <Compass className="w-4 h-4" />
        <span>RBT Test Content Outline (3rd ed.) Terminology Hub</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        RBT & ABA Glossary
      </h1>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        A curated, educational dictionary designed to help Registered Behavior Technician (RBT) candidates, behavior technicians, and students quickly master foundational behavioral principles. Explore concise operational definitions, beginner-friendly translations, fictional clinical scenarios, and common exam pitfalls across all six RBT examination domains.
      </p>

      <ReviewDate 
        publishedAt="2026-09-24T00:00:00Z" 
        lastReviewed="2026-09-24T00:00:00Z" 
      />

      {/* Independent Notice & Official Source Callout */}
      <div class="p-4 sm:p-5 rounded-2xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-xs text-amber-900 dark:text-amber-300 flex items-start gap-3.5">
        <ShieldCheck className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
        <div class="space-y-1.5">
          <span class="font-bold text-slate-900 dark:text-white">Educational Disclaimer & BACB® Notice:</span>
          <p class="leading-relaxed text-amber-800 dark:text-amber-400">
            RBTPracticeExam.xyz is an independent educational test-preparation platform and is not affiliated with, sponsored by, or endorsed by the Behavior Analyst Certification Board® (BACB®). RBT®, Registered Behavior Technician®, and BCBA® are registered trademarks of the BACB®. All glossary definitions are educational aids; official examination blueprints and credential standards should always be verified directly through official BACB resources at <a href="https://www.bacb.com/rbt/" target="_blank" rel="noopener noreferrer" class="font-bold underline hover:text-amber-950 dark:hover:text-white">bacb.com</a>.
          </p>
        </div>
      </div>
    </header>

    {/* Interactive React Island: Live Search, Letter Filter, Domain Filter, and Term Cards */}
    <GlossaryIsland client:load terms={GLOSSARY_TERMS} />

    {/* Knowledge Graph / Cross-Connection Hub Banner */}
    <div class="rounded-3xl bg-slate-100 dark:bg-slate-800/60 p-6 sm:p-8 border border-slate-200 dark:border-slate-700 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5 text-center md:text-left">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center justify-center md:justify-start gap-2">
          <BookOpen className="w-5 h-5 text-amber-600" />
          <span>Connect Theory to Practice</span>
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl">
          Move seamlessly from glossary definitions to full-length domain study guides, practice question drills, and timed mock exams.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
        <a
          href="/study-guides"
          class="px-4 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold shadow-md hover:bg-amber-600 dark:hover:bg-amber-400 dark:hover:text-slate-950 transition-colors"
        >
          All 6 Study Guides →
        </a>
        <a
          href="/practice-questions"
          class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-md flex items-center gap-1.5 transition-colors"
        >
          <HelpCircle className="w-4 h-4" />
          <span>Practice Question Bank</span>
        </a>
        <a
          href="/flashcards"
          class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 text-xs font-bold hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors flex items-center gap-1.5"
        >
          <Layers className="w-4 h-4" />
          <span>Flashcards</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
