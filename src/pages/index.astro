---
import Layout from '@/layouts/Layout.astro';
import { INITIAL_QUESTIONS } from '@/data/mock-data';
---

<Layout title="RBT Practice Exam — 100% Free & Open Access RBT Exam Platform">
  <div class="space-y-16 pb-12">
    <!-- Top Open Access Hero Notification -->
    <div class="bg-gradient-to-r from-brand-600 via-emerald-600 to-teal-600 text-white text-xs sm:text-sm py-2 px-4 text-center font-medium shadow-inner flex items-center justify-center gap-2">
      <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span>
        <strong>100% Free & Open Access:</strong> Instant RBT exam preparation. No sign-up or login required.
      </span>
    </div>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 text-brand-800 dark:text-brand-300 text-xs sm:text-sm font-semibold">
            <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>BACB Task List 2nd Edition Aligned</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15]">
            Pass the RBT Exam.{' '}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 via-emerald-500 to-teal-500">
              Zero Login Friction.
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl">
            Instant, unrestricted access to high-yield RBT practice questions, full timed mock exams, SuperMemo-2 flashcards, and an AI study tutor.
            <strong> No account creation. No password. Just study.</strong>
          </p>

          <!-- Primary CTAs -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a
              href="/practice"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-base shadow-lg shadow-brand-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2.5"
            >
              <span>Start Practicing Now</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="/mock-exam"
              class="w-full sm:w-auto px-6 py-4 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-base shadow-sm transition-all flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              <span>Take Timed Mock Exam</span>
            </a>

            <a
              href="/flashcards"
              class="w-full sm:w-auto px-6 py-4 rounded-xl bg-slate-100 dark:bg-slate-800/60 hover:bg-slate-200 text-slate-700 dark:text-slate-300 font-semibold text-base transition-all flex items-center justify-center gap-2"
            >
              <span>SRS Flashcards</span>
            </a>
          </div>

          <!-- Feature Badges -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 sm:gap-6 pt-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              No Registration Wall
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Instant Auto-Saving Progress
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              100% Free & Open
            </span>
          </div>
        </div>

        <!-- Right Side: Instant Test-Drive Widget -->
        <div class="lg:col-span-5">
          <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl p-6 sm:p-7 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
                Measurement (A-01)
              </span>
              <span class="text-xs text-slate-400">Live Test Drive</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
              What is the term for the elapsed time between the presentation of an instruction (SD) and the client's initiation of the response?
            </h3>
            <div class="space-y-2 pt-2">
              <a href="/practice" class="block p-3 rounded-xl border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300 hover:border-brand-500 hover:bg-brand-50/20">
                A. Duration Recording
              </a>
              <a href="/practice" class="block p-3 rounded-xl border border-emerald-500 bg-emerald-50/60 text-xs font-bold text-emerald-950">
                B. Latency Recording (Correct)
              </a>
              <a href="/practice" class="block p-3 rounded-xl border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300 hover:border-brand-500">
                C. Inter-response Time (IRT)
              </a>
            </div>
            <div class="pt-2 text-center">
              <a href="/practice" class="text-xs font-bold text-brand-600 hover:underline">
                Practice 85+ Real Exam Questions →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Modules Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/practice" class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-brand-500 shadow-sm space-y-3 transition-all">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 flex items-center justify-center font-bold">
            01
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Practice Questions</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Categorized across Measurement, Assessment, Skill Acquisition, Behavior Reduction, and Ethics.
          </p>
        </a>

        <a href="/mock-exam" class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-brand-500 shadow-sm space-y-3 transition-all">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 flex items-center justify-center font-bold">
            02
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Full Mock Exams</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Timed simulations with persistent countdown timers and domain-by-domain diagnostic scorecards.
          </p>
        </a>

        <a href="/flashcards" class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-brand-500 shadow-sm space-y-3 transition-all">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 flex items-center justify-center font-bold">
            03
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">SRS Flashcards</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Scientific SuperMemo-2 Spaced Repetition engine scheduling cards right at memory decay boundaries.
          </p>
        </a>
      </div>
    </section>
  </div>
</Layout>
