---
import Layout from '@/layouts/Layout.astro';
import { INITIAL_QUESTIONS } from '@/data/mock-data';

// Helper to count genuine practice questions in the current dataset matching each topic
function countTopicQuestions(code: string, name: string): number {
  const codeLower = code.toLowerCase();
  const nameFirstWord = name.toLowerCase().split(' ')[0];
  return INITIAL_QUESTIONS.filter((q) => {
    const topic = (q.topicName || '').toLowerCase();
    return topic.includes(codeLower) || (nameFirstWord.length > 3 && topic.includes(nameFirstWord));
  }).length;
}

const TOPIC_DIRECTORIES = [
  {
    domain: 'Domain A — Data Collection and Graphing',
    description: 'Continuous measurement procedures, discontinuous interval sampling, permanent products, and graphical data analysis.',
    topics: [
      { code: 'A-01', name: 'Continuous Measurement', slug: 'continuous-measurement' },
      { code: 'A-02', name: 'Discontinuous Measurement', slug: 'discontinuous-measurement' },
      { code: 'A-03', name: 'Permanent Product Recording', slug: 'permanent-product' },
      { code: 'A-04', name: 'Enter Data & Update Graphs', slug: 'graphing-data' },
    ],
  },
  {
    domain: 'Domain B — Behavior Assessment',
    description: 'Stimulus preference assessments, assisting with functional assessments, and ABC narrative data collection.',
    topics: [
      { code: 'B-01', name: 'Preference Assessments', slug: 'preference-assessments' },
      { code: 'B-02', name: 'Functional Assessment & ABC Data', slug: 'abc-narrative-data' },
    ],
  },
  {
    domain: 'Domain C — Behavior Acquisition',
    description: 'Discrete trial teaching (DTT), task analysis chaining, prompting hierarchies, shaping, and generalization.',
    topics: [
      { code: 'C-01', name: 'Skill Acquisition Plans', slug: 'skill-acquisition-plans' },
      { code: 'C-02', name: 'Prompting & Prompt Fading', slug: 'prompting-hierarchies' },
      { code: 'C-03', name: 'Shaping & Chaining', slug: 'shaping-chaining' },
    ],
  },
  {
    domain: 'Domain D — Behavior Reduction',
    description: 'Functions of behavior (SEAT), differential reinforcement (DRA/DRI/DRO), extinction, and crisis intervention.',
    topics: [
      { code: 'D-01', name: 'Behavior Reduction Plans', slug: 'behavior-reduction-plans' },
      { code: 'D-02', name: 'Differential Reinforcement (DRA/DRI/DRO)', slug: 'differential-reinforcement' },
      { code: 'D-03', name: 'Extinction Procedures', slug: 'extinction-procedures' },
    ],
  },
  {
    domain: 'Domain E — Documentation and Reporting',
    description: 'Objective session notes, legal compliance, communication with supervisors, and mandatory crisis reporting.',
    topics: [
      { code: 'E-01', name: 'Objective Session Notes', slug: 'objective-session-notes' },
      { code: 'E-02', name: 'Incident Reporting & Communication', slug: 'incident-reporting' },
    ],
  },
  {
    domain: 'Domain F — Ethics',
    description: 'RBT Ethics Code (2.0), avoiding dual relationships, gift acceptance rules, client dignity, and supervision requirements.',
    topics: [
      { code: 'F-01', name: 'Professional Boundaries & Gifts', slug: 'professional-boundaries-gifts' },
      { code: 'F-02', name: 'Client Dignity & Communication', slug: 'client-dignity-communication' },
    ],
  },
];
---

<Layout 
  title="RBT Exam Topics & Curriculum Directory | RBT Test Content Outline (3rd ed.)"
  description="Explore exam preparation topics across all six domains of the current RBT Test Content Outline (3rd ed.) with core concepts, formulas, and practice drills."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-fadeIn">
    {/* Page Header */}
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-300 text-xs font-bold uppercase tracking-wider">
        <span>RBT Test Content Outline (3rd ed.) Curriculum</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        RBT Exam Topics & Curriculum Directory
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm max-w-3xl leading-relaxed">
        An independent educational directory organized around the six content domains of the current RBT Test Content Outline (3rd ed.). Select any topic below to review operational definitions, clinical formulas, and targeted practice items.
      </p>
      <div class="text-xs text-slate-500 dark:text-slate-400 pt-1">
        <em>Note:</em> RBTPracticeExam.xyz is an independent study tool not affiliated with or endorsed by the BACB®.
      </div>
    </div>

    {/* Domain Cards */}
    <div class="space-y-8">
      {TOPIC_DIRECTORIES.map((cat) => (
        <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-4 shadow-sm">
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">{cat.domain}</h2>
            <p class="text-xs text-slate-500 mt-0.5">{cat.description}</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {cat.topics.map((t) => {
              const qCount = countTopicQuestions(t.code, t.name);
              return (
                <a
                  href={`/topics/${t.slug}`}
                  class="p-4 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:bg-brand-50/20 dark:hover:bg-brand-950/30 transition-all flex items-center justify-between group"
                >
                  <div>
                    <div class="text-[11px] font-bold text-brand-600 dark:text-brand-400">
                      Item {t.code}
                    </div>
                    <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600">
                      {t.name}
                    </div>
                  </div>
                  <span class="text-xs text-slate-400 font-medium">
                    {qCount > 0 ? `${qCount} Questions` : 'Curating'}
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
