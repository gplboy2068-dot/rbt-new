---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | RBT Practice AI">
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-16 text-center">
    <div class="max-w-md space-y-4">
      <div class="w-16 h-16 rounded-3xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 flex items-center justify-center mx-auto text-2xl font-black shadow-sm">
        404
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white">Page Not Found</h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        The requested study page or resource does not exist or has been moved.
      </p>
      <div class="pt-4">
        <a
          href="/"
          class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-md inline-block transition-all"
        >
          Return to Homepage
        </a>
      </div>
    </div>
  </div>
</Layout>
