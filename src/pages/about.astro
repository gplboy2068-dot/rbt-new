---
import Layout from '@/layouts/Layout.astro';
---

<Layout 
  title="About RBT Practice AI — 100% Free Open Access Platform"
  description="Learn about our mission to provide high-yield, friction-free RBT examination resources for future behavior technicians on rbtpracticeai.com."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
        Our Open Access Mission
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">
        About RBT Practice AI
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl">
        Building the most accessible, high-quality exam preparation platform for Registered Behavior Technicians worldwide.
      </p>
    </div>

    <div class="space-y-6 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-4 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
          Why Open Access & No Login?
        </h2>
        <p>
          Aspiring behavior technicians work tirelessly in classrooms, clinics, and in-home therapy sessions. We believe study tools should be immediately accessible without paywalls, email collection walls, or account creation friction.
        </p>
        <p>
          By utilizing modern client-side IndexedDB database technology, we enable complete progress tracking directly on your device without compromising your privacy or requiring personal data.
        </p>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-3 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">
          BACB Disclaimer & Ethics
        </h2>
        <p class="text-xs text-slate-500 leading-relaxed">
          *BACB®, Behavior Analyst Certification Board®, and Registered Behavior Technician® are registered trademarks of the Behavior Analyst Certification Board. This platform is an independent educational preparatory service and is not affiliated with, endorsed by, or sponsored by the BACB.*
        </p>
      </div>
    </div>
  </div>
</Layout>
