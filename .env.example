# ==============================================================================
# RTB Exam Preparation Platform — Environment Configuration Example
# Cloudflare Workers & Astro.js Architecture
# ==============================================================================

# Public Configuration (Exposed to client bundles where explicitly prefixed)
PUBLIC_APP_NAME="RTB Exam Prep"
PUBLIC_APP_ENV="development"
PUBLIC_SITE_URL="http://localhost:4321"

# Server-Only Configuration & Cloudflare Bindings (NEVER exposed to client JavaScript)
NODE_ENV="development"
ADMIN_JWT_SECRET="replace-with-secure-random-256-bit-key-in-production"

# AI Provider API Keys (Set via `wrangler secret put <NAME>` in Cloudflare Workers)
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Cloudflare Resource Binding Names (Reference in wrangler.toml)
# DB (Cloudflare D1 Database)
# STORAGE_BUCKET (Cloudflare R2 Bucket)
# EDGE_KV (Cloudflare KV Namespace)
# JOBS_QUEUE (Cloudflare Queue)
